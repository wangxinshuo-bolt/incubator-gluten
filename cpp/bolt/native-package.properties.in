format.version=1
platform=@BOLT_PACKAGE_PLATFORM@
arch=@BOLT_PACKAGE_ARCH@
loader.file=@BOLT_LOADER_LIBRARY_FILE@
loader.soname=@BOLT_LOADER_LIBRARY_FILE@
loader.arch=@BOLT_PACKAGE_ARCH@
core.file=@BOLT_CORE_LIBRARY_FILE@
core.soname=@BOLT_CORE_LIBRARY_FILE@
core.arch=@BOLT_PACKAGE_ARCH@
backend.file=@BOLT_BACKEND_LIBRARY_FILE@
backend.soname=@BOLT_BACKEND_LIBRARY_FILE@
backend.arch=@BOLT_PACKAGE_ARCH@
# Non-system DT_NEEDED dependencies continue to use Gluten's existing
# third-party companion Jar and are validated separately from this main-DSO manifest.
dependency.delivery=thirdparty-companion-jar
